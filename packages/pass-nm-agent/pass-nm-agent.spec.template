%global debug_package %{nil}

Name:           pass-nm-agent
Version:        %{pass_nm_agent_version}
Release:        1mamba
ExclusiveArch:  x86_64
Summary:        Lightweight NetworkManager agent for `pass`
License:        GPL-3.0
URL:            https://github.com/grimsteel/${name}
Requires:       pass-secret-service
Requires:       NetworkManager
BuildRequires:  rust
BuildRequires:  cargo
Source0:        %{url}/archive/v%{version}/%{name}-%{version}.tar.gz
Patch0:         bin-location.patch
Patch1:         rust-compile-error.patch

%description
NetworkManager agent for `pass`

Allows NetworkManager connection secrets to be stored inside gpg-encrypted files

# ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓
%prep
%autosetup -p1 -n %{name}-%{version}

# ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓
%build
cargo build --release --locked

# ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓
%install
install -Dm755 target/release/%{name} %{buildroot}%{_bindir}/%{name}
install -Dm644 systemd/%{name}.service \
    %{buildroot}%{_prefix}/lib/systemd/user/%{name}.service

# ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓
%files
#%license LICENSE* https://github.com/grimsteel/pass-nm-agent/issues/1
%doc README*
%{_bindir}/%{name}
%{_prefix}/lib/systemd/user/%{name}.service

