%global debug_package %{nil}

Name:           pass-secret-service
Version:        %{pass_secret_service_version}
Release:        1mamba
ExclusiveArch:  x86_64
Summary:        Implementation of org.freedesktop.secrets using `pass`
License:        GPL-3.0
URL:            https://github.com/grimsteel/pass-secret-service
Requires:       dbus
BuildRequires:  rust
BuildRequires:  cargo
Conflicts:      gnome-keyring
Source0:        %{url}/archive/v%{version}/%{name}-%{version}.tar.gz

%description
Implementation of org.freedesktop.secrets using `pass`

# ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓
%prep
%autosetup -n %{name}-%{version}

# ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓
%build
cargo build --release --locked

# ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓
%install
install -Dm755 target/release/%{name} %{buildroot}%{_bindir}/%{name}
install -Dm644 systemd/org.freedesktop.secrets.service \
    %{buildroot}%{_datadir}/dbus-1/services/org.freedesktop.secrets.service
install -Dm644 systemd/pass-secret-service.service \
    %{buildroot}%{_prefix}/lib/systemd/user/pass-secret-service.service

# ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓
%files
%license LICENSE*
%doc README*
%{_bindir}/%{name}
%{_datadir}/dbus-1/services/org.freedesktop.secrets.service
%{_prefix}/lib/systemd/user/pass-secret-service.service

